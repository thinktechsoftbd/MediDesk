DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mohonto_dental_care?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# ThinkTech ERP integration client: organization create/update is pushed to the ERP under the
# organization's object_id. Server-side only — never prefix these with NEXT_PUBLIC_.
# Leave all three empty to skip the sync. https:// is required except for a localhost ERP.
THINKTECH_ERP_API_URL=""
THINKTECH_ERP_CLIENT_ID=""
THINKTECH_ERP_CLIENT_SECRET=""

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Mohonto Dental Care <no-reply@example.com>"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

WHATSAPP_PROVIDER_URL=""
WHATSAPP_PROVIDER_TOKEN=""

# bKash Tokenized Checkout (official API — developer.bka.sh)
# Sandbox base: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production base: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# ADN SMS gateway (portal.adnsms.com) — used for follow-up and bulk SMS
ADNSMS_API_URL="https://portal.adnsms.com"
ADNSMS_API_KEY=""
ADNSMS_API_SECRET=""

# Bangladesh SMS gateway (bulksmsbd.net) — used for follow-up SMS when set
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""
