generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
  BANK
  MOBILE_BANKING
  OTHER
}

enum PaymentType {
  ADVANCE
  PAYMENT
  REFUND
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Patient {
  id             Int             @id @default(autoincrement())
  patientNo      String          @unique
  name           String
  age            Int?
  dateOfBirth    DateTime?
  gender         Gender?
  // "ADULT" | "CHILD", picked on the patient form
  ageGroup       String?         @db.VarChar(10)
  bloodGroup     String?
  admissionDate  DateTime        @default(now())
  phone          String
  email          String?
  address        String?
  photoUrl       String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  caseHistories  CaseHistory[]
  prescriptions  Prescription[]
  payments       Payment[]
  appointments   Appointment[]
  notifications  Notification[]
  agreements     PatientXAgreement[]
}

model CaseHistory {
  id             Int             @id @default(autoincrement())
  patientId      Int
  caseNo         Int
  toothNumber    String?
  // "ADULT" | "CHILD" tooth chart picked on the prescription page; null: the patient's ageGroup
  ageGroup       String?         @db.VarChar(10)
  // teeth picked under Advice on the prescription page, FDI codes like toothNumber ("36, 46")
  adviceTooth    String?         @db.VarChar(300)
  bp             String?         @db.VarChar(20)
  // O/E items picked on the prescription page, comma separated (see case_finding)
  oe             String?         @db.VarChar(1000)
  followUpDate   DateTime?
  followUpSmsSentAt DateTime?
  problem        String?
  treatment      String?
  details        String?
  caseDate       DateTime        @default(now())
  status         CaseStatus      @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions  Prescription[]
  findings       CaseFinding[]
  @@unique([patientId, caseNo])
  @@index([patientId, caseNo])
  payments       Payment[]
}

model Prescription {
  id             Int             @id @default(autoincrement())
  patientId      Int
  caseHistoryId  Int
  prescriptionNo String          @unique @default(cuid())
  prescribedAt   DateTime        @default(now())
  diagnosis      String?
  notes          String?
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caseHistory    CaseHistory     @relation(fields: [caseHistoryId], references: [id], onDelete: Cascade)
  items          PrescriptionItem[]
  @@index([patientId])
  @@index([caseHistoryId])
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  medicineId     Int
  dosage         String
  duration       String
  instructions   String?
  // structured directions from the Rx page dose editor (src/lib/rx-directions.ts);
  // dosage / duration / instructions above hold the same as plain text
  directions     Json?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine     @relation(fields: [medicineId], references: [id])

  @@map("prescription_item")
}

model Payment {
  id             Int           @id @default(autoincrement())
  patientId      Int
  invoiceNo      String        @unique @default(cuid())
  description    String?
  amount         Decimal       @db.Decimal(12,2)
  discount       Decimal       @db.Decimal(12,2) @default(0)
  paidAmount     Decimal       @db.Decimal(12,2) @default(0)
  type           PaymentType   @default(PAYMENT)
  method         PaymentMethod @default(CASH)
  paymentDate    DateTime      @default(now())
  walletProvider String?       @db.VarChar(20)
  walletNumber   String?       @db.VarChar(20)
  walletTrxId    String?       @db.VarChar(40)
  bkashPaymentId String?       @db.VarChar(50)
  caseHistoryId  Int?
  caseHistory    CaseHistory?  @relation(fields: [caseHistoryId], references: [id], onDelete: SetNull)
  agreementId    Int?
  agreement      PatientXAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  voucher        AccVoucher?
  @@index([patientId, paymentDate])
  @@index([agreementId])
}

// Service charge agreement of a patient. Only one may be open (is_closed = 'N') at a time;
// bill collections are linked to it. Created by prisma/sql/patient_x_agreement.sql.
model PatientXAgreement {
  id                  Int       @id @default(autoincrement())
  patientId           Int       @map("patient_id")
  serviceChargeAmount Decimal   @default(0) @map("service_charge_amount") @db.Decimal(12, 2)
  isClosed            String    @default("N") @map("is_closed") @db.Char(1)
  openDate            DateTime  @default(now()) @map("open_date")
  closedDate          DateTime? @map("closed_date")
  agreementDetails    String?   @map("agreement_details") @db.VarChar(1000)
  createdDate         DateTime  @default(now()) @map("created_date")
  createdBy           String?   @map("created_by") @db.VarChar(150)
  updatedDate         DateTime? @map("updated_date")
  updatedBy           String?   @map("updated_by") @db.VarChar(150)
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@index([patientId, isClosed])
  @@map("patient_x_agreement")
}

model Appointment {
  id           Int      @id @default(autoincrement())
  patientId    Int
  appointmentAt DateTime
  purpose      String?
  reminderSent Boolean  @default(false)
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([appointmentAt])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  menus       Menu[]
}

model Permission {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  name        String
  description String?
  roles       RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  passwordHash    String
  photoUrl        String?
  status          UserStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           UserRole[]
  permissions     UserPermission[]
  menus           UserMenu[]
  resetTokens     PasswordResetToken[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
}

model Menu {
  id          Int        @id @default(autoincrement())
  title       String
  path        String
  icon        String?
  sortOrder   Int        @default(0)
  parentId    Int?
  roleId      Int?
  parent      Menu?      @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Menu[]     @relation("MenuTree")
  role        Role?      @relation(fields: [roleId], references: [id], onDelete: SetNull)
  userMenus   UserMenu[]
  isActive    Boolean    @default(true)
  @@index([parentId, sortOrder])
}

model UserMenu {
  userId    Int
  menuId    Int
  canView   Boolean @default(true)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  @@id([userId, menuId])
}

model GreetingTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  subject     String?
  body        String
  channel     NotificationChannel
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          Int                  @id @default(autoincrement())
  patientId   Int?
  templateId  Int?
  channel     NotificationChannel
  recipient   String
  subject     String?
  body        String
  status      NotificationStatus   @default(PENDING)
  sentAt      DateTime?
  error       String?
  scheduledAt DateTime?
  createdAt   DateTime             @default(now())
  patient     Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
}

model Organization {
  id           Int       @id @default(autoincrement()) @map("organization_id")
  nameEn       String    @map("organization_name_en") @db.VarChar(200)
  nameBn       String?   @map("organization_name_bn") @db.VarChar(200)
  slogan       String?   @db.VarChar(500)
  code         String?   @unique @map("organization_code") @db.VarChar(50)
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(50)
  website      String?   @db.VarChar(255)
  addressLine1 String?   @map("address_line1") @db.VarChar(255)
  addressLine2 String?   @map("address_line2") @db.VarChar(255)
  city         String?   @db.VarChar(100)
  state        String?   @db.VarChar(100)
  postalCode   String?   @map("postal_code") @db.VarChar(20)
  country      String?   @db.VarChar(100)
  logoUrl      String?   @map("logo_url") @db.VarChar(500)
  // doctor's signature printed on the prescription pad, as an image data URL
  signatureUrl String?   @map("signature_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    Int?      @map("created_by")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  updatedBy    Int?      @map("updated_by")

  @@map("organization")
}

// ===== Chart of Accounts (migrated from Oracle) =====

model AccAcParentClass {
  id         Int          @id @default(autoincrement()) @map("acc_ac_parent_class_id")
  name       String       @db.VarChar(50)
  parentCode String       @map("parent_code") @db.Char(1)
  acClasses  AccAcClass[]

  @@map("acc_ac_parent_class")
}

model AccAcClass {
  id            Int              @id @default(autoincrement()) @map("acc_ac_class_id")
  acCode        String?          @map("ac_code") @db.VarChar(3)
  className     String?          @map("class_name") @db.VarChar(50)
  acGroup       String?          @map("ac_group") @db.Char(1)
  parentClassId Int              @map("acc_ac_parent_class_id")
  parentClass   AccAcParentClass @relation(fields: [parentClassId], references: [id])
  mainClasses   AccMainClass[]

  @@map("acc_ac_class")
}

model AccMainClass {
  id                  Int           @id @default(autoincrement()) @map("acc_main_class_id")
  acCode              String?       @map("ac_code") @db.VarChar(3)
  mainCode            String?       @map("main_code") @db.VarChar(5)
  mainName            String?       @map("main_name") @db.VarChar(60)
  acClassId           Int           @map("acc_ac_class_id")
  acClass             AccAcClass    @relation(fields: [acClassId], references: [id])
  mcDisplayOrder      Int?          @map("mc_display_order")
  acDisplayOrder      Int?          @map("ac_display_order")
  acGroupDisplayOrder Int?          @map("ac_group_display_order")
  mapClasses          AccMapClass[]
  voucherDetails      AccVoucherDetail[]

  @@map("acc_main_class")
}

model AccMapClass {
  id          Int           @id @default(autoincrement()) @map("acc_map_class_id")
  mapCode     String?       @map("map_code") @db.Char(4)
  mapName     String?       @map("map_name") @db.VarChar(100)
  prntCode    String?       @map("prnt_code") @db.Char(4)
  acCode      String?       @map("ac_code") @db.VarChar(3)
  mainCode    String?       @map("main_code") @db.VarChar(5)
  mainClassId Int           @map("acc_main_class_id")
  mainClass   AccMainClass  @relation(fields: [mainClassId], references: [id])
  subClasses  AccSubClass[]

  @@map("acc_map_class")
}

model AccSubClass {
  id              Int         @id @default(autoincrement()) @map("acc_sub_class_id")
  acCode          String?     @map("ac_code") @db.VarChar(3)
  mainCode        String?     @map("main_code") @db.VarChar(5)
  subCode         String?     @map("sub_code") @db.VarChar(9)
  subName         String?     @map("sub_name") @db.VarChar(60)
  mcode           String?     @db.Char(3)
  sl              String?     @db.Char(3)
  mapCode         String?     @map("map_code") @db.Char(4)
  mapClassId      Int         @map("acc_map_class_id")
  mapClass        AccMapClass @relation(fields: [mapClassId], references: [id])
  isDummy         String      @default("N") @map("is_dummy") @db.Char(1)
  isCheckBal      String?     @default("N") @map("is_check_bal") @db.Char(1)
  isExclude4Audit String?     @default("N") @map("is_exclude4audit") @db.Char(1)
  lkNatureId      Int         @default(1585) @map("lk_nature_id")

  @@map("acc_sub_class")
}

// Medicine master (medex brand list). Primary key is brand_id; medicines added
// by hand get brand_id 900000001 and up.
model Medicine {
  id                Int       @id @map("brand_id")
  name              String    @map("brand_name")
  dosageForm        String?   @map("dosage_form")
  segment           String?
  strength          String?
  genericName       String?   @map("generic_name")
  company           String?
  priceText         String?   @map("price_text")
  priceAmount       Decimal?  @map("price_amount") @db.Decimal(12, 2)
  url               String
  scrapedAt         DateTime  @default(now()) @map("scraped_at") @db.Timestamptz(6)
  // doctor's usual directions, filled in when the medicine is picked on a case
  dosage            String?
  duration          String?
  instructions      String?
  // the same defaults as structured directions, set from the Rx page dose editor
  directions        Json?
  prescriptionItems PrescriptionItem[]

  @@map("medicine")
}

// ===== Journal Vouchers =====

model AccVoucher {
  id               Int                @id @default(autoincrement())
  voucherNo        String             @unique @db.VarChar(20)
  voucherPostingId String?            @db.VarChar(20)
  voucherDate      DateTime           @default(now())
  postingDate      DateTime?
  isPosted         String             @default("N") @db.Char(1)
  voucherType      String             @default("Journal") @db.VarChar(40)
  paymentMode      String?            @db.VarChar(30)
  narration        String?            @db.VarChar(300)
  paymentId   Int?               @unique
  payment     Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  details     AccVoucherDetail[]
  createdBy   String?            @db.VarChar(150)
  createdDate DateTime           @default(now())
  updatedBy   String?            @db.VarChar(150)
  updatedDate DateTime?          @updatedAt

  @@map("acc_voucher")
}

model AccVoucherDetail {
  id             Int          @id @default(autoincrement())
  voucherId      Int
  voucher        AccVoucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accMainClassId Int
  accMainClass   AccMainClass @relation(fields: [accMainClassId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  lineNarration  String?      @db.VarChar(200)

  @@map("acc_voucher_detail")
}

// Review list written by prisma/sql/medicine_replace.sql: which old medicine
// went to which new one. Not used by the app.
model MedicineMigrationMap {
  oldId        Int       @id @map("old_id")
  oldName      String?   @map("old_name")
  oldStrength  String?   @map("old_strength")
  oldForm      String?   @map("old_form")
  usedInCases  Int?      @map("used_in_cases")
  newId        Int?      @map("new_id")
  newName      String?   @map("new_name")
  newStrength  String?   @map("new_strength")
  newForm      String?   @map("new_form")
  matchType    String?   @map("match_type")
  migratedAt   DateTime? @default(now()) @map("migrated_at")

  @@map("medicine_migration_map")
}

// One-time password reset links sent by email (only the SHA-256 of the token is stored)
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

// O/E (oral examination) findings master, with default remarks. Table created by hand;
// ids are assigned by the app (max + 1). created_by / last_updated_by hold the user id.
model OralExamDisease {
  id              Int       @id
  diseaseName     String    @unique @map("disease_name") @db.VarChar(150)
  createdBy       Int?      @map("created_by")
  createdDate     DateTime  @default(now()) @map("created_date") @db.Timestamp(6)
  lastUpdatedBy   Int?      @map("last_updated_by")
  lastUpdatedDate DateTime? @map("last_updated_date") @db.Timestamp(6)
  remarks         String?   @db.VarChar(250)

  @@map("oral_exam_disease")
}

// Saved Rx medicine lists ("dent pain", "RCT"...) applied from the prescription page.
// items: [{ medicineId, directions }]
model PrescriptionTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  items     Json
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prescription_template")
}

// Chip lists of the prescription page pickers: COMPLAINT, INVESTIGATION, DIAGNOSIS,
// TREATMENT, ADVICE (src/lib/clinical-findings.ts). On Examination chips come from
// oral_exam_disease.
model ClinicalTerm {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(20)
  name      String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, name])
  @@map("clinical_term")
}

// Items picked for a case on the prescription page, in order, with a free-text note
// (e.g. tooth "21"). case_history.problem / oe / treatment / details hold the same
// items as text (src/lib/clinical-findings.ts), for the case list, the case page and the pad print.
model CaseFinding {
  id            Int         @id @default(autoincrement())
  caseHistoryId Int         @map("case_history_id")
  category      String      @db.VarChar(20)
  term          String
  note          String?     @db.VarChar(200)
  sortOrder     Int         @default(0) @map("sort_order")
  caseHistory   CaseHistory @relation(fields: [caseHistoryId], references: [id], onDelete: Cascade)

  @@index([caseHistoryId])
  @@map("case_finding")
}
